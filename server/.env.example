# 가족 코드: 앱 설정에 똑같이 입력합니다. 아래 명령으로 만들어 쓰세요.
#   openssl rand -base64 18
FAMILY_TOKEN=여기에-가족-코드

# 안드로이드 푸시(FCM): Firebase 서비스 계정 키 파일을 ./data/에 두면 자동으로 켜짐
FCM_CREDENTIALS=/data/firebase-service-account.json

# (선택) ntfy 알림 — 아이폰 알림을 정하기 전 임시로 쓸 때만. 비워두면 꺼짐
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

APP_NAME=어디댔지
TZ=Asia/Seoul
